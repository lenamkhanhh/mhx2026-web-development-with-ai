# Copy these public Firebase Web values into the repository-root `.env.local`.
# Never place service-account JSON, private keys, or Admin SDK credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Keep this false for normal local/production Firebase. The Playwright config
# overrides it with a demo project and loopback-only emulators during E2E.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8085
